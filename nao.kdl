recipe "default" {
  task "build" description="Build the workspace" {
    run shell="cargo build --workspace --all-targets --all-features"
  }

  task "fmt" description="Check code formatting" {
    run shell="cargo fmt --all --check"
  }

  task "clippy" description="Run clippy across the workspace" {
    depends-on "build"
    run shell="cargo clippy --workspace --all-targets --all-features -- -D warnings"
  }

  task "test" description="Run the test suite" {
    depends-on "build"
    run shell="cargo nextest run --workspace --all-targets --all-features"
  }

  task "check-code" description="Run the full repository verification script" {
    depends-on "fmt"
    depends-on "clippy"
    depends-on "test"
    run script="./scripts/check-code.sh"
  }
}
