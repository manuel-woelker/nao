recipe "default" {
  task "build" description="Build the workspace" {
    run shell="""
      cargo build \
        --workspace \
        --all-targets \
        --all-features
    """
  }

  task "fmt" description="Check code formatting" {
    run shell="""
      cargo fmt \
        --all \
        --check
    """
  }

  task "clippy" description="Run clippy across the workspace" {
    depends-on "build"
    run shell="""
      cargo clippy \
        --workspace \
        --all-targets \
        --all-features \
        -- \
        -D warnings
    """
  }

  task "test" description="Run the test suite" {
    depends-on "build"
    run shell="""
      TEST_OUTPUT_FILE="$(mktemp)"

      if ! cargo nextest run \
        --workspace \
        --all-targets \
        --all-features \
        --show-progress=none \
        --status-level fail \
        --no-fail-fast \
        >"$TEST_OUTPUT_FILE" 2>&1; then
        cat "$TEST_OUTPUT_FILE"
        rm -f "$TEST_OUTPUT_FILE"
        exit 1
      fi

      cat "$TEST_OUTPUT_FILE"

      EXECUTED_TESTS="$(
        awk '
          /Summary .* tests run:/ {
            if (match($0, / ([0-9]+) tests run:/, matches)) {
              total += matches[1]
            }
          }
          END {
            print total + 0
          }
        ' "$TEST_OUTPUT_FILE"
      )"

      rm -f "$TEST_OUTPUT_FILE"
      printf 'Task outcome: %s tests passed\n' "$EXECUTED_TESTS"
    """
  }

  task "check" description="Run all repository verification tasks" {
    depends-on "fmt"
    depends-on "clippy"
    depends-on "test"
    run shell="""
      printf 'All repository verification tasks completed.\n'
    """
  }

  task "check-code" description="Run the full repository verification task graph" {
    depends-on "check"
    run script="./scripts/check-code.sh"
  }

  task "hello-docker" description="Print a greeting from a container" {
    run container="alpine:3.22" {
      args "sh" "-lc" "printf 'hello from docker\n'; printf 'Task outcome: greeted from docker\n'"
    }
  }

  task "hello-compose" description="Print a greeting through the checked-in Compose service" {
    run compose=".docker" service="rust" {
      args "bash" "-lc" "printf 'hello from compose\n'; printf 'Task outcome: greeted from compose\n'"
    }
  }

  task "fail1" description="Print 1" {
    run shell="""
      printf '1\n'
    """
  }

  task "fail2" description="Print 2 after fail1" {
    depends-on "fail1"
    run shell="""
      printf '2\n'
    """
  }

  task "fail3" description="Print 3 and fail after fail2" {
    depends-on "fail2"
    run shell="""
      printf '3\n'
      for i in $(seq 1 200); do
        printf 'fail3 line %03d: this task is intentionally producing a wall of text before failing\n' "$i"
      done
      printf 'fail3 is about to fail\n'
      exit 1
    """
  }

  task "fail4" description="Print 4 after fail3" {
    depends-on "fail3"
    run shell="""
      printf '4\n'
    """
  }

  task "fail5" description="Print 5 after fail4" {
    depends-on "fail4"
    run shell="""
      printf '5\n'
    """
  }

  task "shortfail" description="Print 200 lines and fail" {
    run shell="""
      for i in $(seq 1 200); do
        printf 'shortfail line %02d: this task fails after a shorter output block\n' "$i"
      done
      exit 1
    """
  }

  task "false-no-echo" description="Run false and skip the follow-up echo" {
    run shell="""
      echo "This should be executed"
      false
      echo "This should not be executed"
    """
  }

  task "slow1" description="Sleep for 1 second" {
    run shell="""
      sleep 1
      printf 'Task outcome: slept for 1 second\n'
    """
  }

  task "counter" description="Report a counter once per second" {
    run shell="""
      for count in 1 2 3 4 5; do
        printf 'Task status: count %s/5\n' "$count"
        sleep 1
      done
      printf 'Task outcome: counted to 5\n'
    """
  }

  task "slow2" description="Sleep for 2 seconds" {
    run shell="""
      sleep 2
      printf 'Task outcome: slept for 2 seconds\n'
    """
  }

  task "slow3" description="Sleep for 3 seconds" {
    run shell="""
      sleep 3
      printf 'Task outcome: slept for 3 seconds\n'
    """
  }

  task "slow4" description="Sleep for 4 seconds" {
    run shell="""
      sleep 4
      printf 'Task outcome: slept for 4 seconds\n'
    """
  }

  task "slow5" description="Sleep for 5 seconds" {
    run shell="""
      sleep 5
      printf 'Task outcome: slept for 5 seconds\n'
    """
  }
}
